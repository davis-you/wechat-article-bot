# WeChat Official Account
WECHAT_APP_ID=your_app_id
WECHAT_APP_SECRET=your_app_secret

# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Notification (WeChat Work / WeCom group robot webhook)
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key

# Web review page
WEB_PUBLIC_URL=https://your-domain.com:8080
WEB_SECRET_TOKEN=your_random_secret_for_review_page
