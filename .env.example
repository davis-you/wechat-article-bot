# WeChat Official Account
WECHAT_APP_ID=your_app_id
WECHAT_APP_SECRET=your_app_secret

# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# WeChat Work (企业微信应用消息推送)
WECHAT_WORK_CORP_ID=your_corp_id
WECHAT_WORK_AGENT_ID=your_agent_id
WECHAT_WORK_SECRET=your_agent_secret
WECHAT_WORK_ADMIN_USER_ID=your_user_id

# Web review page
WEB_PUBLIC_URL=https://your-domain.com:8080
WEB_SECRET_TOKEN=your_random_secret_for_review_page
