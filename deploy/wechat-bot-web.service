[Unit]
Description=WeChat Article Bot - Review Web UI
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/wechat-bot
EnvironmentFile=/opt/wechat-bot/.env
ExecStart=/opt/wechat-bot/.venv/bin/uvicorn web.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
